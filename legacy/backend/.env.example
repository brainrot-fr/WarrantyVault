# HTTP server
PORT=8080

# Supabase project and private Storage access
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_STORAGE_BUCKET=bills
SIGNED_URL_SECONDS=600

# Optional explicit signing-key set endpoint; takes precedence over the legacy secret.
SUPABASE_JWKS_URL=
# Optional legacy HS256 JWT secret. Used only when SUPABASE_JWKS_URL is unset.
SUPABASE_JWT_SECRET=

# Database credentials. Use Supabase's transaction-pooler JDBC URL in hosted deployments;
# include prepareThreshold=0 (for example, ...:6543/postgres?prepareThreshold=0).
SUPABASE_DB_URL="jdbc:postgresql://aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0"
SUPABASE_DB_USERNAME=postgres.your-project-ref
SUPABASE_DB_PASSWORD=replace-with-database-password

# Comma-separated browser origins allowed to access the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# SMTP delivery
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

# Receipt OCR; requires Tesseract and English language data in the runtime image.
OCR_ENABLED=false
TESSDATA_PATH=/usr/share/tesseract-ocr/5/tessdata

# Reminder scheduler and protected manual trigger (X-Cron-Secret header)
SCHEDULER_ENABLED=false
CRON_SECRET=replace-with-a-long-random-secret
REMINDER_CRON="0 0 9 * * *"

# Other service settings
FRONTEND_URL=http://localhost:5173
INVITE_EXPIRY_DAYS=7
